# Configuração da plataforma aplicada pelo GitOps (sobrepõe /etc/mgdn-platform/env).
# Fica aqui, e não no cloud-init, para mudar sem recriar as VMs.

# Servidor de controle da tailnet (ADR 0010). Os aparelhos são migrados com
# `tailscale up --force-reauth --login-server https://<este host>`.
HEADSCALE_HOSTNAME=headscale.mgdn.com.br
