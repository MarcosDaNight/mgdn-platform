# Copie para terraform.tfvars (gitignored). Segredos da plataforma (URLs de ping,
# tópico do ntfy, credenciais do backup, IP de casa) NÃO vão aqui: ficam cifrados em
# secrets/<papel>.env.age (ADR 0014, `make secrets-edit ROLE=primary`).
# As chaves age dos hosts (host_age_keys) vêm de ~/.config/mgdn-platform/age/ pelo
# Makefile; não precisam ser copiadas para cá.

cloudflare_api_token = "..." # Zone:Read e DNS:Edit só em mgdn.com.br (ADR 0010)

# ssh_break_glass = true   # só se a tailnet estiver fora
